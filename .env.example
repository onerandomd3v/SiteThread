# Server-only values. Never prefix these with NEXT_PUBLIC_.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

R2_ACCOUNT_ID=""
R2_BUCKET_NAME="sitethread-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_REF=""

# The legacy raw endpoint remains isolated for the old adapter. The hackathon live
# transcription path uses the official creative endpoint without a bearer.
LIVEPEER_MCP_URL="https://agent.livepeer.org/api/mcp/raw"
LIVEPEER_CREATIVE_MCP_URL="https://agent.livepeer.org/api/mcp/creative"
LIVEPEER_MCP_BEARER=""

# Required only when MEDIA_PROVIDER_MODE="live" for visual semantics.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
MEDIA_PROVIDER_MODE="fixture"
