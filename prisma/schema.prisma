generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaAssetKind {
  SOURCE_VIDEO
  SOURCE_AUDIO
  SOURCE_IMAGE
  EXTRACTED_FRAME
  EVIDENCE_CLIP
  THUMBNAIL
}

enum MediaAssetStatus {
  PENDING
  AVAILABLE
  FAILED
}

enum ProcessingStatus {
  UPLOADING
  UPLOADED
  QUEUED
  TRANSCRIBING
  ANALYZING_MEDIA
  EXTRACTING_OBSERVATIONS
  NEEDS_REVIEW
  REVIEWED
  REPORT_READY
  PROCESSING_FAILED
}

enum ObservationType {
  PROGRESS
  POTENTIAL_ISSUE
  ACTION
  NOTE
}

enum ObservationSourceBasis {
  NARRATION
  VISUAL
  NARRATION_AND_VISUAL
}

enum ReviewState {
  DRAFT
  CONFIRMED
  EDITED
  DISMISSED
}

model Project {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  walkthroughs Walkthrough[]
}

model Walkthrough {
  id                 String              @id @default(cuid())
  projectId          String
  title              String?
  capturedAt         DateTime?
  durationSeconds    Float?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAssets        MediaAsset[]
  processingRuns     ProcessingRun[]
  transcriptSegments TranscriptSegment[]
  observations       Observation[]
  reports            Report[]

  @@index([projectId, createdAt])
}

model MediaAsset {
  id                 String                @id @default(cuid())
  walkthroughId      String
  kind               MediaAssetKind
  status             MediaAssetStatus      @default(PENDING)
  objectKey          String
  mimeType           String
  byteSize           Int?
  durationSeconds    Float?
  sourceStartSeconds Float?
  sourceEndSeconds   Float?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  walkthrough        Walkthrough           @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  transcriptSegments TranscriptSegment[]
  evidence           ObservationEvidence[]

  @@unique([walkthroughId, objectKey])
  @@index([walkthroughId, kind])
}

model ProcessingRun {
  id              String           @id @default(cuid())
  walkthroughId   String
  pipelineVersion String
  idempotencyKey  String           @unique
  status          ProcessingStatus @default(UPLOADING)
  failedStep      String?
  errorCode       String?
  errorMessage    String?
  retryCount      Int              @default(0)
  providerJobIds  Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  walkthrough     Walkthrough      @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)

  @@unique([walkthroughId, pipelineVersion])
  @@index([walkthroughId, status])
}

model TranscriptSegment {
  id            String                @id @default(cuid())
  walkthroughId String
  sourceAssetId String?
  sequence      Int
  startSeconds  Float
  endSeconds    Float
  text          String
  speaker       String?
  language      String?
  createdAt     DateTime              @default(now())
  walkthrough   Walkthrough           @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  sourceAsset   MediaAsset?           @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)
  evidence      ObservationEvidence[]

  @@unique([walkthroughId, sequence])
  @@index([walkthroughId, startSeconds])
}

model Observation {
  id                String                 @id @default(cuid())
  walkthroughId     String
  type              ObservationType
  sourceBasis       ObservationSourceBasis
  originalDraftText String
  editedText        String?
  location          String?
  trade             String?
  confidence        Float?
  reviewState       ReviewState            @default(DRAFT)
  reviewerId        String?
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  walkthrough       Walkthrough            @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  evidence          ObservationEvidence[]
  reportItems       ReportObservation[]

  @@index([walkthroughId, reviewState])
}

model ObservationEvidence {
  id                  String             @id @default(cuid())
  observationId       String
  mediaAssetId        String?
  transcriptSegmentId String?
  sourceStartSeconds  Float?
  sourceEndSeconds    Float?
  label               String?
  createdAt           DateTime           @default(now())
  observation         Observation        @relation(fields: [observationId], references: [id], onDelete: Cascade)
  mediaAsset          MediaAsset?        @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  transcriptSegment   TranscriptSegment? @relation(fields: [transcriptSegmentId], references: [id], onDelete: SetNull)

  @@index([observationId])
}

model Report {
  id            String              @id @default(cuid())
  walkthroughId String
  generatedBy   String?
  generatedAt   DateTime            @default(now())
  createdAt     DateTime            @default(now())
  walkthrough   Walkthrough         @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  observations  ReportObservation[]

  @@index([walkthroughId, generatedAt])
}

model ReportObservation {
  id            String          @id @default(cuid())
  reportId      String
  observationId String
  text          String
  type          ObservationType
  sortOrder     Int
  createdAt     DateTime        @default(now())
  report        Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  observation   Observation     @relation(fields: [observationId], references: [id], onDelete: Restrict)

  @@unique([reportId, observationId])
  @@index([reportId, sortOrder])
}
