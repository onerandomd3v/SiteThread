generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaAssetKind {
  SOURCE_VIDEO
  SOURCE_AUDIO
  SOURCE_IMAGE
  EXTRACTED_FRAME
  EVIDENCE_CLIP
  THUMBNAIL
}

enum MediaAssetStatus {
  PENDING
  AVAILABLE
  FAILED
}

enum ProcessingStatus {
  UPLOADING
  UPLOADED
  QUEUED
  TRANSCRIBING
  ANALYZING_MEDIA
  EXTRACTING_OBSERVATIONS
  NEEDS_REVIEW
  REVIEWED
  REPORT_READY
  PROCESSING_FAILED
}

enum ObservationType {
  PROGRESS
  POTENTIAL_ISSUE
  ACTION
  NOTE
}

enum ObservationSourceBasis {
  NARRATION
  VISUAL
  NARRATION_AND_VISUAL
}

enum ReviewState {
  DRAFT
  CONFIRMED
  EDITED
  DISMISSED
}

model Project {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  walkthroughs Walkthrough[]
}

model Walkthrough {
  id                 String              @id @default(cuid())
  projectId          String
  uploadIntentKey    String?             @unique
  title              String?
  capturedAt         DateTime?
  durationSeconds    Float?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAssets        MediaAsset[]
  processingRuns     ProcessingRun[]
  transcriptSegments TranscriptSegment[]
  visualCandidates   VisualCandidate[]
  observations       Observation[]
  reports            Report[]

  @@index([projectId, createdAt])
}

model MediaAsset {
  id                 String                @id @default(cuid())
  walkthroughId      String
  kind               MediaAssetKind
  status             MediaAssetStatus      @default(PENDING)
  objectKey          String
  stagingObjectKey   String?
  mimeType           String
  byteSize           Int?
  durationSeconds    Float?
  sourceStartSeconds Float?
  sourceEndSeconds   Float?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  walkthrough        Walkthrough           @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  transcriptSegments TranscriptSegment[]
  evidence           ObservationEvidence[]
  visualCandidates   VisualCandidate[]

  @@unique([walkthroughId, objectKey])
  @@index([walkthroughId, kind])
}

model ProcessingRun {
  id              String           @id @default(cuid())
  walkthroughId   String
  pipelineVersion String
  idempotencyKey  String           @unique
  status          ProcessingStatus @default(UPLOADING)
  failedStep      String?
  errorCode       String?
  errorMessage    String?
  retryable       Boolean?
  retryCount      Int              @default(0)
  providerJobIds  Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  walkthrough     Walkthrough      @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  transcriptSegments TranscriptSegment[]
  visualCandidates VisualCandidate[]
  providerInvocations ProviderInvocation[]
  observations Observation[]

  @@unique([walkthroughId, pipelineVersion])
  @@index([walkthroughId, status])
}

model TranscriptSegment {
  id            String                @id @default(cuid())
  walkthroughId String
  processingRunId String?
  sourceAssetId String?
  sequence      Int
  startSeconds  Float
  endSeconds    Float
  text          String
  speaker       String?
  language      String?
  createdAt     DateTime              @default(now())
  walkthrough   Walkthrough           @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  processingRun ProcessingRun?        @relation(fields: [processingRunId], references: [id], onDelete: SetNull)
  sourceAsset   MediaAsset?           @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)
  evidence      ObservationEvidence[]

  @@index([walkthroughId, sequence])
  @@index([walkthroughId, startSeconds])
  @@index([processingRunId, sequence])
  @@unique([processingRunId, sourceAssetId, startSeconds, endSeconds])
}

model ProviderInvocation {
  id             String        @id @default(cuid())
  processingRunId String
  idempotencyKey String        @unique
  provider       String
  capability     String
  stage          String
  sourceStartSeconds Float
  sourceEndSeconds Float
  status         String
  rawResponse    Json?
  errorCode      String?
  retryable      Boolean?
  latencyMs      Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  processingRun  ProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Cascade)
  visualCandidates VisualCandidate[]

  @@index([processingRunId, stage])
}

model VisualCandidate {
  id                  String             @id @default(cuid())
  processingRunId     String
  walkthroughId       String
  mediaAssetId        String
  providerInvocationId String
  clipStartSeconds    Float
  clipEndSeconds      Float
  sourceStartSeconds  Float
  sourceEndSeconds    Float
  eventStartSeconds   Float?
  eventEndSeconds     Float?
  text                String
  provider            String
  capability          String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  processingRun       ProcessingRun      @relation(fields: [processingRunId], references: [id], onDelete: Cascade)
  walkthrough         Walkthrough        @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  mediaAsset          MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  providerInvocation  ProviderInvocation @relation(fields: [providerInvocationId], references: [id], onDelete: Cascade)

  @@unique([processingRunId, mediaAssetId])
  @@index([walkthroughId, sourceStartSeconds])
}

model Observation {
  id                String                 @id @default(cuid())
  walkthroughId     String
  processingRunId   String?
  sequence          Int?
  type              ObservationType
  sourceBasis       ObservationSourceBasis
  originalDraftText String
  suggestedAction   String?
  editedText        String?
  location          String?
  trade             String?
  confidence        Float?
  reviewState       ReviewState            @default(DRAFT)
  reviewerId        String?
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  walkthrough       Walkthrough            @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  processingRun     ProcessingRun?         @relation(fields: [processingRunId], references: [id], onDelete: SetNull)
  evidence          ObservationEvidence[]
  reportItems       ReportObservation[]

  @@unique([processingRunId, sequence])
  @@index([walkthroughId, reviewState])
}

model ObservationEvidence {
  id                  String             @id @default(cuid())
  observationId       String
  mediaAssetId        String?
  transcriptSegmentId String?
  sourceStartSeconds  Float?
  sourceEndSeconds    Float?
  label               String?
  createdAt           DateTime           @default(now())
  observation         Observation        @relation(fields: [observationId], references: [id], onDelete: Cascade)
  mediaAsset          MediaAsset?        @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  transcriptSegment   TranscriptSegment? @relation(fields: [transcriptSegmentId], references: [id], onDelete: SetNull)

  @@index([observationId])
}

model Report {
  id            String              @id @default(cuid())
  walkthroughId String
  generatedBy   String?
  generatedAt   DateTime            @default(now())
  createdAt     DateTime            @default(now())
  walkthrough   Walkthrough         @relation(fields: [walkthroughId], references: [id], onDelete: Cascade)
  observations  ReportObservation[]

  @@index([walkthroughId, generatedAt])
}

model ReportObservation {
  id            String          @id @default(cuid())
  reportId      String
  observationId String
  text          String
  type          ObservationType
  reviewState   ReviewState
  reviewerId    String?
  reviewedAt    DateTime?
  sortOrder     Int
  createdAt     DateTime        @default(now())
  report        Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  observation   Observation     @relation(fields: [observationId], references: [id], onDelete: Restrict)
  evidence      ReportObservationEvidence[]

  @@unique([reportId, observationId])
  @@index([reportId, sortOrder])
}

model ReportObservationEvidence {
  id                  String           @id @default(cuid())
  reportObservationId String
  sourceWalkthroughId String
  sourceEvidenceId    String
  mediaAssetId        String?
  transcriptSegmentId String?
  sourceStartSeconds  Float?
  sourceEndSeconds    Float?
  label               String?
  createdAt           DateTime         @default(now())
  reportObservation  ReportObservation @relation(fields: [reportObservationId], references: [id], onDelete: Cascade)

  @@index([reportObservationId])
}
